$bog_molefy_ring $mol_view
	parts /$bog_molefy_ring_part
	income \
	expense \
	pick? \
	sub /
		<= Chart $mol_svg_root
			view_box \0 0 100 100
			sub <= arcs /
				<= Arc* $mol_svg_path
					geometry <= arc_geometry* \
					style *
						^
						stroke <= part_color* \
		<= Center $mol_view
			sub /
				<= Income $mol_paragraph
					title <= income
				<= Expense $mol_paragraph
					title <= expense
		<= Spots $mol_view
			sub <= spots /
				<= Spot* $mol_button_minor
					hint <= part_name* \
					click? <=> part_pick*? null
					style *
						^
						left <= spot_left* \
						top <= spot_top* \
						color <= part_color* \
					sub /
						<= Spot_icon* $bog_molefy_icon
							name <= part_icon* \
						<= Spot_share* $mol_view
							sub /
								<= part_share* \

$mol_icon_minus $mol_icon path \M19,13H5V11H19V13Z

$mol_icon_plus $mol_icon path \M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z

$mol_check_expand $mol_check
	Icon $mol_icon_chevron
	level 0
	style *
		^
		paddingLeft <= level_style \0px
	checked? <=> expanded? false
	enabled <= expandable false

$mol_expander $mol_list
	rows /
		<= Label $mol_view
			sub /
				<= Trigger $mol_check_expand
					checked? <=> expanded? false
					expandable <= expandable true
					label <= label /
						<= title
				<= Tools null
		<= Content $mol_list
			rows <= content /

$mol_page $mol_view
	dom_name \article
	attr *
		^
		tabIndex <= tabindex -1
	sub /
		<= Head $mol_view
			minimal_height 64
			dom_name \header
			sub <= head /
				<= Title $mol_view
					dom_name \h1
					sub <= title_content /
						<= Logo null
						<= title
				<= Tools $mol_view
					sub <= tools /$mol_view_content
		<= Body $mol_scroll
			scroll_top? => body_scroll_top?
			sub <= body_content /
				<= Body_content $mol_view
					sub <= body /$mol_view
		<= Foot $mol_view
			dom_name \footer
			sub <= foot /$mol_view

$bog_molefy_login $mol_page
	title @ \Molefy
	grant? null
	own? null
	status? \
	provider \https://b-on-g.github.io/id/
	body /
		<= List $mol_list
			rows /
				<= Intro $mol_paragraph
					title @ \Учёт расходов в зашифрованной базе. Данные видите только вы.
				<= Id $mol_button_major
					title @ \Войти через Гипер ID
					click? <=> id_enter? null
				<= Make $mol_button_minor
					title @ \Создать ключ
					click? <=> key_make? null
				<= Key_label $mol_paragraph
					title @ \Или вход по своему ключу:
				<= Key $mol_string
					hint @ \Ключ с другого устройства
					value? <=> key? \
					submit? <=> key_enter? null
				<= Key_enter $mol_button_minor
					title @ \Войти по ключу
					click? <=> key_enter? null
				<= Status $mol_paragraph
					title <= status?

$mol_icon_delete $mol_icon path \M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z

$mol_icon_delete_outline $mol_icon path \M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19M8,9H16V19H8V9M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z

$mol_icon_backspace $mol_icon path \M22,3H7C6.31,3 5.77,3.35 5.41,3.88L0,12L5.41,20.11C5.77,20.64 6.31,21 7,21H22A2,2 0 0,0 24,19V5A2,2 0 0,0 22,3M19,15.59L17.59,17L14,13.41L10.41,17L9,15.59L12.59,12L9,8.41L10.41,7L14,10.59L17.59,7L19,8.41L15.41,12

$mol_icon_backspace_outline $mol_icon path \M19,15.59L17.59,17L14,13.41L10.41,17L9,15.59L12.59,12L9,8.41L10.41,7L14,10.59L17.59,7L19,8.41L15.41,12L19,15.59M22,3A2,2 0 0,1 24,5V19A2,2 0 0,1 22,21H7C6.31,21 5.77,20.64 5.41,20.11L0,12L5.41,3.88C5.77,3.35 6.31,3 7,3H22M22,5H7L2.28,12L7,19H22V5Z

$bog_molefy_entry $mol_page
	book $bog_molefy_book
	id \
	kind \out
	category \
	account \
	close? null
	title <= head_title \
	title_out @ \Новый расход
	title_in @ \Новый доход
	title_transfer @ \Перевод
	title_edit @ \Операция
	tools /
		<= Drop $mol_button_minor
			hint @ \Удалить
			click? <=> drop? null
			sub /
				<= Drop_icon $mol_icon_delete_outline
		<= Close $mol_button_minor
			hint @ \Закрыть
			click? <=> close?
			sub /
				<= Close_icon $mol_icon_close
	body <= fields /
		<= Day $mol_date
			value? <=> day? \
		<= Accounts $mol_view
			sub <= account_fields /
				<= From $mol_select
					value? <=> from? \
					dictionary <= account_names *
				<= Arrow $bog_molefy_icon
					name \transfer
				<= To $mol_select
					value? <=> to? \
					dictionary <= account_names
		<= Amount_row $mol_view
			sub /
				<= Amount $mol_string
					hint \0
					keyboard \decimal
					value? <=> text? \
					submit? <=> submit? null
				<= Back $mol_button_minor
					hint @ \Стереть
					click? <=> back? null
					sub /
						<= Back_icon $mol_icon_backspace_outline
		<= Got $mol_string
			hint @ \Зачислено в валюте счёта
			keyboard \decimal
			value? <=> got_text? \
		<= Note $mol_string
			hint @ \Заметка
			value? <=> note? \
		<= Keys $mol_view
			sub <= keys /
				<= Key* $mol_button_minor
					title <= key_title* \
					click? <=> press*? null
		<= Repeat $mol_select
			Filter null
			value? <=> every? \
			dictionary *
				none @ \Не повторять
				day @ \Каждый день
				week @ \Каждую неделю
				month @ \Каждый месяц
				year @ \Каждый год
		<= Hint $mol_paragraph
			title <= hint @ \Выберите категорию, операция сохранится
		<= Categories $mol_view
			sub <= category_buttons /
				<= Category* $mol_button_minor
					click? <=> category_pick*? null
					style *
						^
						color <= category_color* \
					sub /
						<= Category_icon* $bog_molefy_icon
							name <= category_icon* \
						<= Category_name* $mol_view
							sub /
								<= category_name* \
		<= Save $mol_button_major
			title @ \Сохранить
			click? <=> submit?

$mol_labeler $mol_list
	rows /
		<= Label $mol_view
			minimal_height 32
			sub <= label /$mol_view_content
				<= title
		<= Content $mol_view
			minimal_height 24
			sub <= content /

$mol_icon_tick $mol_icon path \M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z

$mol_check_box $mol_check
	Icon $mol_icon_tick

$mol_icon_upload $mol_icon path \M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z

$mol_button_open $mol_button_minor
	sub /
		<= Icon $mol_icon_upload
		<= Native $mol_button_open_native
			files? <=> files_handled? <=> files? /File
			accept <= accept \
			multiple <= multiple true

$mol_button_open_native $mol_view
	dom_name \input
	files? /File
	attr *
		type \file
		accept <= accept \
		multiple <= multiple true
	event *
		change? <=> picked? null

$bog_qr $mol_svg_root
	uri \
	module_radius 0.35
	finder_radius 1.2
	gradient_angle 45
	error_correction \M
	quiet_zone 2
	center /
	gradient_id \qr-grad
	gradient_fill \url(#qr-grad)
	gradient_stops /
		\var(--mol_theme_special)
		\var(--mol_theme_focus)
	Stop* $mol_svg
		dom_name \stop
		attr *
			^
			offset <= stop_offset* \0%
			stop-color <= stop_color* \
	view_box <= qr_view_box \0 0 1 1
	sub /
		<= Defs $mol_svg
			dom_name \defs
			sub /
				<= Gradient $mol_svg
					dom_name \linearGradient
					attr *
						^
						id <= gradient_id
						x1 <= grad_x1 \0
						y1 <= grad_y1 \0
						x2 <= grad_x2 \1
						y2 <= grad_y2 \1
					sub <= gradient_stop_list /
		<= Modules $mol_svg_path
			geometry <= modules_d \
			attr *
				^
				fill <= gradient_fill
		<= Rings $mol_svg_path
			geometry <= rings_d \
			attr *
				^
				fill <= gradient_fill
				fill-rule \evenodd
		<= Centers $mol_svg_path
			geometry <= centers_d \
			attr *
				^
				fill <= gradient_fill
		<= Center_wrap $mol_svg
			dom_name \foreignObject
			attr *
				^
				x <= center_x \0
				y <= center_y \0
				width <= center_size \0
				height <= center_size
			sub /
				<= Center_body $mol_view
					sub <= center

$mol_icon_clipboard $mol_icon path \M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3

$mol_icon_clipboard_outline $mol_icon path \M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V5H19V19H5V5H7V7Z

$mol_button_copy $mol_button_minor
	blobs /$mol_blob
		<= text_blob? $mol_blob /
			/BlobPart <= text <= title
			* type \text/plain
		<= html_blob? $mol_blob /
			/BlobPart <= html \
			* type \text/html
	data *
	sub /
		<= Icon $mol_icon_clipboard_outline
		<= title \

$mol_video_player $mol_view
	dom_name \video
	playing? false
	play null
	pause null
	volume? 0
	time? 0
	duration 0
	attr *
		src <= uri \
		controls <= controls true
		autoplay <= autoplay true
		playsinline <= inline true
		loop <= loop false
		muted <= muted false
		poster <= poster \
	field *
		srcObject <= stream null
	event *
		volumechange? <=> revolume? null
		timeupdate? <=> retime? null
		durationchange? <=> redurate? null
		playing? <=> playing_event? null
		play? <=> play_event? null
		pause? <=> pause_event? null

$mol_video_camera $mol_video_player
	controls false
	style *
		transform <= transform \
	video_constraints *
		facingMode <= facing \user
		aspectRatio <= aspect 1
		width * ideal <= width <= size 720
		height * ideal <= height <= size
	video_settings *
		brightness <= brightness 128
		sharpness <= sharpness 2
		contrast <= contrast 32
		saturation <= saturation 64
		advanced /
			* colorTemperature <= temperature 4000
			* torch <= torch false


$bog_keyqr_scan $mol_view
	scanning? false
	found? \
	sub /
		<= Toggle $mol_check
			title @ \Сканировать QR
			checked? <=> scanning?
		<= Camera $mol_video_camera
			facing \environment
			muted true

$bog_keyqr $mol_list
	key \
	found? \
	shown? false
	rows /
		<= Show $mol_check
			title @ \Показать ключ
			checked? <=> shown?
		<= Warning $mol_paragraph
			title @ \Ключ даёт полный доступ к аккаунту. Показывайте его только своему устройству.
		<= Qr $bog_qr
			uri <= key
			error_correction \L
		<= Copy $mol_button_copy
			title @ \Скопировать ключ
			text <= key
		<= Scan $bog_keyqr_scan
			found? <=> found?

$bog_molefy_settings $mol_page
	book $bog_molefy_book
	close? null
	leave? null
	account_key \
	account_lord \
	title @ \Настройки
	tools /
		<= Close $mol_button_minor
			hint @ \Закрыть
			click? <=> close?
			sub /
				<= Close_icon $mol_icon_close
	body /
		<= Money $mol_labeler
			title @ \Основная валюта
			content /
				<= Currency $mol_string
					value? <=> currency? \
		<= Rates $mol_list
			rows <= rate_rows /
				<= Rate* $mol_labeler
					title <= rate_title* \
					content /
						<= Rate_value* $mol_string
							keyboard \decimal
							hint \1
							value? <=> rate*? \
		<= Budget $mol_labeler
			title @ \Бюджет на месяц
			content /
				<= Budget_value $mol_string
					keyboard \decimal
					hint @ \Без ограничения
					value? <=> budget? \
		<= Carry $mol_check_box
			title @ \Переносить остаток с прошлых периодов
			checked? <=> carry? false
		<= Accounts $mol_labeler
			title @ \Счета
			content /
				<= Account_list $mol_list
					rows <= account_rows /
						<= Account* $mol_expander
							title <= account_name*? \
							content /
								<= Account_name* $mol_string
									hint @ \Название
									value? <=> account_name*?
								<= Account_cur* $mol_string
									hint @ \Валюта
									value? <=> account_cur*? \
								<= Account_init* $mol_string
									hint @ \Начальный остаток
									keyboard \decimal
									value? <=> account_init*? \
								<= Account_icon* $mol_select
									value? <=> account_icon*? \
									options <= icon_names /string
								<= Account_total* $mol_check_box
									title @ \Учитывать в общем балансе
									checked? <=> account_total*? true
								<= Account_off* $mol_check_box
									title @ \В архиве
									checked? <=> account_off*? false
						<= Account_add $mol_button_minor
							title @ \Добавить счёт
							click? <=> account_add? null
		<= Categories $mol_labeler
			title @ \Категории
			content /
				<= Category_list $mol_list
					rows <= category_rows /
						<= Category* $mol_expander
							title <= category_name*? \
							content /
								<= Category_name* $mol_string
									hint @ \Название
									value? <=> category_name*?
								<= Category_icon* $mol_select
									value? <=> category_icon*? \
									options <= icon_names
								<= Category_off* $mol_check_box
									title @ \В архиве
									checked? <=> category_off*? false
						<= Category_add_out $mol_button_minor
							title @ \Добавить категорию расхода
							click? <=> category_add_out? null
						<= Category_add_in $mol_button_minor
							title @ \Добавить категорию дохода
							click? <=> category_add_in? null
		<= Repeats $mol_labeler
			title @ \Повторы
			content /
				<= Repeat_list $mol_list
					rows <= repeat_rows /
						<= Repeat* $mol_view
							sub /
								<= Repeat_title* $mol_paragraph
									title <= repeat_title* \
								<= Repeat_drop* $mol_button_minor
									hint @ \Остановить
									click? <=> repeat_drop*? null
									sub /
										<= Repeat_drop_icon* $mol_icon_delete_outline
					Empty <= Repeat_empty $mol_paragraph
						title @ \Нет
		<= Restore $mol_labeler
			title @ \Восстановление из CSV или .db
			content /
				<= Restore_list $mol_list
					rows <= restore_rows /
						<= Open $mol_button_open
							multiple false
							accept \.csv,.db
							files? <=> files? /File
						<= Found $mol_paragraph
							title <= found \
						<= Append $mol_button_major
							title @ \Дополнить без дублей
							click? <=> restore_append? null
						<= Replace $mol_button_minor
							title @ \Заменить всё
							click? <=> restore_replace? null
						<= Restore_status $mol_paragraph
							title <= restore_status? \
		<= Export $mol_button_minor
			title @ \Выгрузить CSV
			click? <=> export? null
		<= Key $mol_labeler
			title @ \Вход
			content /
				<= Key_list $mol_list
					rows <= key_rows /
						<= Lord $mol_paragraph
							title <= account_lord
						<= Key_hint $mol_paragraph
							title @ \Сохраните ключ: без него данные не открыть на другом устройстве.
						<= Qr $bog_keyqr
							key <= account_key
							Scan null
						<= Leave $mol_button_minor
							title @ \Выйти
							click? <=> leave?

$bog_molefy_app $mol_book2
	plugins /
		<= Theme $bog_theme_auto
	Placeholder null
	Book $bog_molefy_book
		store <= store null
	Own_book $bog_molefy_book
		store <= own_store null
	Login $bog_molefy_login
		grant? <=> grant? null
		own? <=> own_enter? null
	Wait $mol_page
		title @ \Molefy
		body /
			<= Wait_text $mol_paragraph
				title @ \Ждём данные. Если долго, проверьте сеть, ключ или доступ в Гипер ID.
			<= Wait_leave $mol_button_minor
				title @ \Выйти
				click? <=> leave? null
	Menu $mol_page
		title @ \Molefy
		tools /
			<= Status $giper_baza_status
			<= Theme_toggle $bog_theme_toggle
				theme_auto <= Theme
			<= Settings_link $mol_link
				hint @ \Настройки
				arg <= settings_arg *
				sub /
					<= Settings_icon $mol_icon_settings
		body /
			<= Merge $mol_list
				rows <= merge_rows /
					<= Merge_text $mol_paragraph
						title @ \На этом устройстве есть данные под своим ключом.
					<= Merge_run $mol_button_major
						title @ \Перенести сюда
						click? <=> merge? null
					<= Merge_skip $mol_button_minor
						title @ \Не переносить
						click? <=> merge_skip? null
			<= Period $mol_switch
				value? <=> period? \month
				options *
					day @ \День
					week @ \Неделя
					month @ \Месяц
					year @ \Год
					all @ \Всё время
					range @ \Интервал
			<= Date $mol_date
				hint @ \Выбрать дату
				value? <=> day? \
			<= Range $mol_view
				sub <= range_fields /
					<= Range_from $mol_date
						value? <=> range_from? \
					<= Range_till $mol_date
						value? <=> range_till? \
			<= Accounts $mol_list
				rows <= account_links /
					<= Account* $mol_link
						arg <= account_arg* *
						sub /
							<= Account_icon* $bog_molefy_icon
								name <= account_icon* \
							<= Account_name* $mol_view
								sub /
									<= account_name* @ \Все счета
							<= Account_balance* $mol_view
								sub /
									<= account_balance* \
	Main $mol_page
		title <= period_title \
		head /
			<= Prev $mol_button_minor
				hint @ \Назад
				click? <=> prev? null
				sub /
					<= Prev_icon $mol_icon_chevron_left
			<= Period_title $mol_view
				sub /
					<= period_title
			<= Next $mol_button_minor
				hint @ \Вперёд
				click? <=> next? null
				sub /
					<= Next_icon $mol_icon_chevron_right
			<= Transfer_link $mol_link
				hint @ \Перевод
				arg <= transfer_arg *
				sub /
					<= Transfer_icon $mol_icon_swap_horizontal
			<= Search_link $mol_link
				hint @ \Поиск
				arg <= search_arg *
				sub /
					<= Search_icon $mol_icon_magnify
		body <= main_body /
			<= Seed $mol_button_major
				title @ \Начать с готовыми счетами
				click? <=> seed? null
			<= Ring $bog_molefy_ring
				parts <= parts /$bog_molefy_ring_part
				income <= income_text \
				expense <= expense_text \
				pick? <=> part_pick? \
			<= Budget $mol_paragraph
				title <= budget_text \
		foot /
			<= Minus $mol_link
				hint @ \Расход
				arg <= minus_arg *
				sub /
					<= Minus_icon $mol_icon_minus
			<= Balance $mol_link
				arg <= feed_arg *
				sub /
					<= balance_text \
			<= Plus $mol_link
				hint @ \Доход
				arg <= plus_arg *
				sub /
					<= Plus_icon $mol_icon_plus
	Feed $mol_page
		title @ \Операции
		tools /
			<= Feed_close $mol_button_minor
				hint @ \Закрыть
				click? <=> close? null
				sub /
					<= Feed_close_icon $mol_icon_close
		body /
			<= Groups $mol_list
				rows <= group_rows /
					<= Group* $mol_expander
						title <= group_title* \
						content /
							<= Group_ops* $mol_list
								rows <= group_ops* /
				Empty <= Feed_empty $mol_paragraph
					title @ \Операций нет
	Search $mol_page
		title @ \Поиск
		tools /
			<= Search_close $mol_button_minor
				hint @ \Закрыть
				click? <=> close?
				sub /
					<= Search_close_icon $mol_icon_close
		body /
			<= Query $mol_search
				hint @ \Заметка, категория, сумма
				query? <=> query? \
			<= Found $mol_list
				rows <= found_rows /
	Op* $mol_link
		arg <= op_arg* *
		sub /
			<= Op_icon* $bog_molefy_icon
				name <= op_icon* \
			<= Op_title* $mol_view
				sub /
					<= op_title* \
			<= Op_sum* $mol_view
				sub /
					<= op_sum* \
	Entry* $bog_molefy_entry
		book <= Book
		id <= entry_id* \
		kind <= entry_kind* \
		category <= entry_category* \
		account <= account \
		close? <=> close?
	Settings $bog_molefy_settings
		book <= Book
		close? <=> close?
		leave? <=> leave?
		account_key <= account_key \
		account_lord <= account_lord \
